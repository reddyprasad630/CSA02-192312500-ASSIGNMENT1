TASK 5 – Organise the Program with Header Files and Conditional Compilation (3 Marks)
1. Brief explanation
A C program can be divided into header files (.h) and source files (.c) to make it easier to maintain and debug.
- Header file: Contains constants, macros and function prototypes.
- Source file: Contains the function implementations.
- main(): Accepts input and controls the program.
- Other functions: Perform calculations such as electricity bill computation.
Include guards prevent a header file from being included multiple times in the same compilation unit. #ifdef DEBUG enables diagnostic messages only when debugging is enabled.

CODE:


#include <stdio.h>
#include "billing.h"

long compute_bill(int units)
{
    long paise = FIXED_CHARGE_PAISE;
    int slab2 = 0;
    int slab3 = 0;

    if (units < 0)
        return -1;

    if (units > SLAB1_UNITS)
    {
        slab2 = (units < SLAB2_UNITS)
                    ? units - SLAB1_UNITS
                    : SLAB2_UNITS - SLAB1_UNITS;

        paise += (long)slab2 * RATE2_PAISE;
    }

    if (units > SLAB2_UNITS)
    {
        slab3 = units - SLAB2_UNITS;
        paise += (long)slab3 * RATE3_PAISE;
    }

#ifdef DEBUG
    printf("[DEBUG] Units = %d\n", units);
    printf("[DEBUG] Slab 2 units = %d\n", slab2);
    printf("[DEBUG] Slab 3 units = %d\n", slab3);
    printf("[DEBUG] Fixed charge = %ld paise\n",
           (long)FIXED_CHARGE_PAISE);
    printf("[DEBUG] Final bill = %ld paise\n", paise);
#endif

    return paise;
}

int main(void)
{
    int units;
    long bill;

    printf("Enter units consumed: ");

    if (scanf("%d", &units) != 1 || units < 0)
    {
        printf("Invalid input!\n");
        return 1;
    }

    bill = compute_bill(units);

    printf("Units consumed: %d\n", units);
    printf("Total bill: Rs. %ld.%02ld\n",
           bill / 100, bill % 100);

    return 0;
}
 

